{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" },
    { "source": "/api/businesses/:id", "destination": "/api/businesses?id=:id" },
    { "source": "/api/products/:id", "destination": "/api/products?id=:id" },
    { "source": "/api/customers/:id/history", "destination": "/api/customers?id=:id&action=history" },
    { "source": "/api/customers/:id", "destination": "/api/customers?id=:id" },
    { "source": "/api/invoices/:id", "destination": "/api/invoices?id=:id" }
  ]
}
